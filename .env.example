# ── Sentinel backend configuration ───────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.

# PostgreSQL (docker compose default shown). Tests override with SQLite.
DATABASE_URL=postgresql+psycopg2://sentinel:sentinel@localhost:5433/sentinel

# ML API (remote mode)
ML_API_URL=https://accident-severity-api-production.up.railway.app
ML_TIMEOUT_S=10

# remote = call ML_API_URL/predict | local = load artifacts/ and run in-process
INFERENCE_MODE=remote

# Shared API key for ESP32 ingestion and responder-dashboard compatibility.
API_KEY=change-me-sentinel-dev-key

# Optional extra keys with roles, JSON map of key -> role (driver|responder|device).
# The single API_KEY above is always accepted with role "responder".
# ROLE_KEYS={"device-key-1": "device", "driver-key-1": "driver"}
ROLE_KEYS=

# Dedicated signing secret for short-lived driver access tokens. Generate a
# long random value for every deployment; changing it signs out every driver.
JWT_SECRET=change-me-to-a-long-random-jwt-secret
JWT_ISSUER=sentinel-backend
JWT_AUDIENCE=sentinel-mobile
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Comma-separated allowed origins for the dashboard and driver web app.
CORS_ORIGINS=http://localhost:5173
DRIVER_APP_ORIGINS=https://sentinel-app-gold.vercel.app

# Heartbeat retention (days) for the pruning job.
HEARTBEAT_RETENTION_DAYS=7

# SMS relay (POST /api/v1/sms/send) — replaces the SIM800L when GSM is down
# SMS_PROVIDER: arkesel | twilio | console (log only, testing) | empty = disabled (503)
SMS_PROVIDER=
SMS_SENDER_ID=Sentinel
# Comma-separated numbers the device may text, in addition to its registered emergency contacts
SMS_ALLOWED_RECIPIENTS=
SMS_RATE_LIMIT_PER_10MIN=20
ARKESEL_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
